 namespace libcamera {
 
+/*
+ * Frames are YUV420 laid out like the Raspberry Pi ISP output: luma rows are
+ * padded to kStrideAlign bytes and chroma rows are half the luma stride
+ * (1456x1088 gives strides of 1472 and 736).
+ */
+struct Yuv420Layout {
+	static constexpr unsigned int kStrideAlign = 32;
+
+	explicit Yuv420Layout(const Size &size)
+		: yStride((size.width + kStrideAlign - 1) / kStrideAlign * kStrideAlign),
+		  uvStride(yStride / 2),
+		  ySize(yStride * size.height),
+		  uvSize(uvStride * ((size.height + 1) / 2))
+	{
+	}
+
+	unsigned int yStride;
+	unsigned int uvStride;
+	unsigned int ySize;
+	unsigned int uvSize;
+};
+
 class FrameGenerator
 {
 public:
